{
  "name": "apisip",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first Chrome extension to capture, inspect, replay and load-test APIs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server": "node tests/server.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:authorize": "node tests/authorize.mjs",
    "site:dev": "node scripts/serve-site.mjs",
    "test:site": "playwright test --config playwright.site.config.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "author": "Mihir Bhadak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihirbhadak/ApiSip.git"
  },
  "bugs": {
    "url": "https://github.com/mihirbhadak/ApiSip/issues"
  },
  "homepage": "https://mihirbhadak.github.io/ApiSip/"
}
